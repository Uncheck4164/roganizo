# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Tu user ID numérico de Telegram (el bot ignora a cualquier otro)
TELEGRAM_ALLOWED_USER_ID=123456789

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Providers preferidos en orden (admite variante de cuantización, ej deepinfra/fp4).
OPENROUTER_PROVIDER_ORDER=deepinfra/fp4,baidu
# Al hacer fallback, elegir siempre el más barato
OPENROUTER_SORT=price

# Google OAuth (Cloud Console → credenciales OAuth, tipo "Web application")
# Redirect URI a registrar: {PUBLIC_URL}/oauth/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# URL pública de la app (en dev: http://localhost:8080)
PUBLIC_URL=http://localhost:8080
PORT=8080

# Web read-only
WEB_PASSWORD=cambiame
WEB_SESSION_SECRET=un-string-largo-y-aleatorio

# Llamadas de Telegram para recordatorios urgentes no confirmados (CallMeBot).
# Tu @usuario de Telegram; vacío = sin llamadas. Autorizar una vez en @CallMeBot_txtbot.
CALLMEBOT_USER=

# General
TIMEZONE=America/Santiago
# Hora del briefing matutino (HH:mm). Vacío = desactivado.
BRIEFING_TIME=07:30
DATABASE_PATH=./data/roganizo.db
