# Configuration precedence: values saved from the web UI (stored in the SQLite
# settings table) > environment variables > built-in defaults. Environment
# variables are never copied into the database.
#
# This file is entirely optional: with no .env at all the app still boots and
# opens the browser setup screen at PUBLIC_URL, where every value below can be
# filled in. DATABASE_PATH is the exception — it locates the database itself, so
# it can only be set here.

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Your numeric Telegram user ID (the bot ignores everybody else)
TELEGRAM_ALLOWED_USER_ID=123456789

# LLM provider: openrouter | openai. Only the active provider's key is required.
LLM_PROVIDER=openrouter

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional backup model, same role as OPENROUTER_MODEL_STRONG. Empty = never escalate.
OPENAI_MODEL_STRONG=
# Base model's reasoning: none | low | medium | high. gpt-6.1-sol and gpt-6-astra
# reject "none"; the backup model always runs at "low".
OPENAI_REASONING_EFFORT=none

# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Optional: better model the agent switches to on its own, mid-turn, when the
# cheap one gets something wrong. Empty = never escalate.
OPENROUTER_MODEL_STRONG=
# Lowest endpoint quantization allowed: any | 6bit | 8bit | 16bit. 4-bit endpoints
# are the cheapest and the worst at tool calling, which is all this bot does.
OPENROUTER_QUALITY_FLOOR=8bit
# Price ceiling for the everyday model as "prompt,completion" in USD per million
# tokens. It does not apply to OPENROUTER_MODEL_STRONG. Empty = none.
OPENROUTER_MAX_PRICE=
# Preferred providers in order (a quantization variant is allowed, e.g. deepinfra/fp4).
# Empty = let OpenRouter choose.
OPENROUTER_PROVIDER_ORDER=
# auto = OpenRouter balances price against availability. price/throughput/latency
# pin one attribute and switch that balance off.
OPENROUTER_SORT=auto

# Google OAuth (Cloud Console -> OAuth credentials, type "Web application")
# Redirect URI to register: {PUBLIC_URL}/oauth/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Public URL of the app (in dev: http://localhost:8080)
PUBLIC_URL=http://localhost:8080
PORT=8080

# Read-only web dashboard
WEB_PASSWORD=changeme
# Optional: generated automatically and persisted on first boot if left unset.
WEB_SESSION_SECRET=a-long-random-string

# Telegram calls for unacknowledged urgent reminders (CallMeBot).
# Your @username on Telegram; empty = no calls. Authorize once in @CallMeBot_txtbot.
CALLMEBOT_USER=

# General
TIMEZONE=America/Santiago
# Language of every user-facing message (bot, briefing, agent): es | en
LANGUAGE=es
# Morning briefing time (HH:mm). Empty = disabled.
BRIEFING_TIME=07:30
# Environment-only setting (it locates the database, so the UI cannot change it).
DATABASE_PATH=./data/roganizo.db
