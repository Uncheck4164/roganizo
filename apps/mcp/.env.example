# Copy to apps/mcp/.env and fill in. This file is gitignored (the root .gitignore
# ignores `.env` at any depth), so the password never reaches the repository.

# Base URL of the instance to talk to. Defaults to http://localhost:8080.
ROGANIZO_URL=https://your-instance.example.com

# The web password of THAT instance — the one the web UI asks for.
# A deployed instance keeps its password in its own database, so it is usually
# not the WEB_PASSWORD of your local .env.
ROGANIZO_PASSWORD=
